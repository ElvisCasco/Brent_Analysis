# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Thesis-source qmd kept out of the repo
synthetic_*.qmd

# Jupyter checkpoints
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# Generated standalone HTML plots from 02_Fit_Models (interactive plots also live in
# notebook outputs; the standalone copies in plots/ are regenerated each run).
# Plot files are gitignored by default — see explicit allowlist further below.

# Local copies of cited papers / external PDFs for personal reading
references/

presentation/*
!presentation/**/*.pdf
!presentation/**/*.tex
!presentation/*.pdf
!presentation/*.tex

# Ignore plots/ except the milestone2 subfolder (un-ignore the directory itself first,
# then its contents — gitignore won't re-include files inside an excluded directory).
plots/*
!plots/milestone2/
!plots/milestone2/*
# Allow-list standalone interactive HTMLs for GitHub Pages publication.
!plots/eda_*.html

# Claude Code session state (transcripts, task outputs, memory, local settings)
.claude/

# Loose reference papers / personal transcripts (cited papers belong in references/)
/*.pdf
docs/*.docx


